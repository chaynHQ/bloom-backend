{
  "name": "bloom-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "NODE_ENV=development nest start --watch",
    "start:debug": "NODE_ENV=development nest start --debug --watch",
    "start:staging": "node -r newrelic dist/src/main --optimize_for_size --max_old_space_size=460 --gc_interval=100",
    "start:prod": "node -r newrelic dist/src/main --optimize_for_size --max_old_space_size=460 --gc_interval=100",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest",
    "test:watch": "NODE_ENV=test NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --watch",
    "test:cov": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --coverage",
    "test:debug": "node --experimental-vm-modules --no-warnings=ExperimentalWarning --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_OPTIONS='--experimental-vm-modules --no-warnings=ExperimentalWarning' jest --config ./test/jest-e2e.json",
    "seed": "bash ./staging_backup.sh -c",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "yarn typeorm -- -d ./src/typeorm.config.ts migration:generate ./src/migrations/bloom-backend",
    "migration:run": "yarn typeorm migration:run -- -d ./src/typeorm.config.ts",
    "migration:revert": "yarn typeorm -- -d ./src/typeorm.config.ts migration:revert",
    "migration:show": "yarn build && yarn typeorm -- migration:show -d ./src/typeorm.config.ts"
  },
  "dependencies": {
    "@mailchimp/mailchimp_marketing": "^3.0.80",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.4.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/platform-socket.io": "^12.4.0",
    "@nestjs/schedule": "^12.0.3",
    "@nestjs/swagger": "^12.1.1",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.0",
    "axios": "^1.21.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.9",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.3",
    "jsdom": "^30.1.3",
    "lodash": "^4.18.1",
    "luxon": "^3.7.2",
    "multer": "^2.5.0",
    "nestjs-cls": "^7.0.2",
    "newrelic": "^14.11.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "pg-connection-string": "^2.14.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.1.4",
    "rollbar": "^4.2.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "storyblok-js-client": "^7.9.0",
    "typeorm": "^1.1.2",
    "uuid": "^14.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@golevelup/ts-jest": "^3.0.0",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/validator": "^13.15.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": ">=24.15.0",
    "yarn": "1.x"
  },
  "resolutions": {
    "uuid": "^14.0.3",
    "protobufjs": "^7.6.6",
    "ws": "^8.22.1",
    "superagent/form-data": "^2.5.6",
    "newrelic/@grpc/grpc-js": "^1.14.7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "modulePaths": [
      "<rootDir>"
    ],
    "testPathIgnorePatterns": [
      "src/migrations",
      "dist",
      "coverage"
    ]
  }
}
